{
  "name": "ltpp/ltpp-ssh",
  "type": "project",
  "description": "LTPP-SSH",
  "authors": [
    {
      "name": "SQS",
      "email": "root@ltpp.vip",
      "role": "Developer"
    }
  ],
  "keywords": [
    "ltpp",
    "ssh"
  ],
  "require": {
    "php": ">=7.2",
    "workerman/webman-framework": "^1.5.0",
    "monolog/monolog": "^2.9.2",
    "webman/console": "^1.3"
  },
  "suggest": {
    "ext-event": "For better performance. "
  },
  "autoload": {
    "psr-4": {
      "": "./",
      "app\\": "./app",
      "App\\": "./app",
      "app\\View\\Components\\": "./app/view/components"
    },
    "files": [
      "./support/helpers.php"
    ]
  },
  "scripts": {
    "post-package-install": [
      "support\\Plugin::install"
    ],
    "post-package-update": [
      "support\\Plugin::install"
    ],
    "pre-package-uninstall": [
      "support\\Plugin::uninstall"
    ]
  }
}